/*
    PREPROC_DWI default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/preproc_dwi/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Global options**//
    dwi_shell_tolerance                             = 20

    //**DWI: Processing options**//
    run_dwi_synthstrip                              = false
    keep_dwi_with_skull                             = false

    //**DWI: Denoise (dwidenoise in Mrtrix3)**//
    run_dwi_denoising                               = true
    extent                                          = 7

    //**DWI: GIBBS CORRECTION (mrdegibbs in Mrtrix3)**//
    run_gibbs_correction                            = true

    //**DWI: N4 bias correction options**//
    run_dwi_N4                                      = true

    //**DWI: Normalize**//
    run_dwi_normalize                               = true
    fa_mask_threshold                               = 0.4

    //**DWI: Resample**//
    run_dwi_resampling                              = true
    dwi_resolution                                  = 1
    dwi_interpolation                               = "lin"

    //**Extract DTI shells using this value as maximum**//
    dti_max_shell_value                             = 1200
    dti_shells                                      = null

    //**DWI: Brain extraction**//
    bet_dwi_final_f                                 = 0.16
}

includeConfig '../../../modules/nf-neuro/denoising/mppca/nextflow.config'
includeConfig '../../../modules/nf-neuro/preproc/gibbs/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/powderaverage/nextflow.config'
includeConfig '../../../modules/nf-neuro/betcrop/synthstrip/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/applymask/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/cropvolume/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/convert/nextflow.config'
includeConfig '../../../modules/nf-neuro/betcrop/fslbetcrop/nextflow.config'
includeConfig '../../../modules/nf-neuro/preproc/n4/nextflow.config'
includeConfig '../../../modules/nf-neuro/preproc/normalize/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/resample/nextflow.config'
includeConfig '../../../modules/nf-neuro/utils/extractb0/nextflow.config'

includeConfig '../topup_eddy/nextflow.config'

process {
    withName: ".*PREPROC_DWI:BETCROP_FSLBETCROP" {
        ext.bet_f   = { params.bet_dwi_final_f }
        ext.b0_thr  = { params.b0_thr_extract_b0 }
        ext.crop    = { params.keep_dwi_with_skull ? false : true }
        ext.keep_image_with_skull = { params.keep_dwi_with_skull ? true : false }
        ext.dilate  = false
    }

    withName: ".*PREPROC_DWI:DENOISE_DWI" {
        ext.extent = { params.extent }
    }

    withName: ".*PREPROC_DWI:DENOISE_REVDWI" {
        ext.extent = { params.extent }
    }

    withName: ".*PREPROC_DWI:CONVERT" {
        ext.datatype = "uint8"
    }

    withName: ".*PREPROC_DWI:CROPDWI" {
        ext.output_bbox = true
    }

    withName: ".*PREPROC_DWI:RESAMPLE_DWI" {
        ext.voxel_size      = { params.dwi_resolution }
        ext.interp          = { params.dwi_interpolation }
        ext.first_suffix    = "dwi"
    }

    withName: ".*PREPROC_DWI:RESAMPLE_MASK" {
        ext.interp          = "nn"
        ext.first_suffix    = "dwi_mask"
    }

    withName: ".*PREPROC_DWI:N4_DWI" {
        ext.bspline_knot_per_voxel  = 0.25
        ext.shrink_factor           = 2
    }

    withName: ".*PREPROC_DWI:NORMALIZE_DWI" {
        ext.dwi_shell_tolerance = { params.dwi_shell_tolerance }
        ext.max_dti_shell_value = { params.dti_max_shell_value }
        ext.dti_shells = { params.dti_shells }
        ext.fa_mask_threshold = { params.fa_mask_threshold }
    }
}
