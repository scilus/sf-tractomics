/*
    ATLAS_IIT default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/atlas_iit/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**IIT**//
    atlas_iit_smooth_sigma                          = 1.0
    atlas_iit_b0                                    = null
    atlas_iit_bundle_masks_dir                      = null
    use_binary_masks                                = false
}

includeConfig '../../../modules/nf-neuro/image/math/nextflow.config'

process {
    withName: ".*ATLAS_IIT:THR_BUNDLE_MASK" {
        ext.prefix = { "${meta.id}" }
    }

    withName: ".*ATLAS_IIT:THR_BUNDLE_MASK" {
        ext.operation = 'lower_threshold'
        ext.suffix    = 'mask'
        ext.data_type = 'int32'
    }

    withName: ".*ATLAS_IIT:SMOOTH_MASK" {
        ext.operation = 'blur'
        ext.suffix    = 'smoothed'
        ext.data_type = 'float32'
    }

    withName: ".*ATLAS_IIT:THR_SMOOTHED_MASK" {
        ext.operation = 'lower_threshold'
        ext.suffix    = 'mask'
        ext.data_type = 'int32'
    }
}
