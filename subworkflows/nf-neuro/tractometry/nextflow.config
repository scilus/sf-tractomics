/*
    TRACTOMETRY default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/tractometry/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Tractometry options**//
    nb_points                                       = 10
    tractometry_covariates                          = 'site,age,sex,handedness,disease'
}

includeConfig '../../../modules/nf-neuro/tractogram/removeinvalid/nextflow.config'
includeConfig '../../../modules/nf-neuro/bundle/fixelafd/nextflow.config'
includeConfig '../../../modules/nf-neuro/bundle/centroid/nextflow.config'
includeConfig '../../../modules/nf-neuro/tractogram/resample/nextflow.config'
includeConfig '../../../modules/nf-neuro/bundle/labelmap/nextflow.config'
includeConfig '../../../modules/nf-neuro/bundle/uniformize/nextflow.config'
includeConfig '../../../modules/nf-neuro/bundle/stats/nextflow.config'

process {
    withName: ".*TRACTOMETRY:BUNDLE_CENTROID" {
        ext.nb_points = { params.nb_points }
    }

    withName: ".*TRACTOMETRY:BUNDLE_LABELMAP" {
        ext.nb_points = { params.nb_points }
    }

    withName: ".*TRACTOMETRY:BUNDLE_STATS" {
        ext.meta_columns = { params.tractometry_covariates.split(",") }
    }

    withName: ".*TRACTOMETRY:TRACTOGRAM_RESAMPLE" {
        ext.nb_points = { params.nb_points }
    }
}
