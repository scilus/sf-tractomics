/*
    OUTPUT_TEMPLATE_SPACE default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/output_template_space/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Output template space**//
    template                                        = null
    templateflow_resolution                         = null
    templateflow_cohort                             = null
    use_template_t2w                                = false
    templateflow_home                               = "./templateflow"
}

includeConfig '../../../modules/nf-neuro/utils/templateflow/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/applymask/nextflow.config'
includeConfig '../../../modules/nf-neuro/betcrop/fslbetcrop/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/antsapplytransforms/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/tractogram/nextflow.config'

includeConfig '../registration/nextflow.config'

process {
    withName: ".*OUTPUT_TEMPLATE_SPACE:BET_T1W" {
        ext.bet_f   = 0.6
        ext.crop    = false
        ext.dilate  = false
    }

    withName: ".*OUTPUT_TEMPLATE_SPACE:REGISTRATION:REGISTRATION_ANTS" {
        ext.suffix = { "${params.template}" }
    }

    withName: ".*OUTPUT_TEMPLATE_SPACE:WARPIMAGES" {
        ext.interpolation = 'Linear'
        ext.output_dtype = "float"
    }

    withName: ".*OUTPUT_TEMPLATE_SPACE:WARPMASK" {
        ext.interpolation = 'NearestNeighbor'
        ext.output_dtype = "int"
    }

    withName: ".*OUTPUT_TEMPLATE_SPACE:WARPLABELS" {
        ext.interpolation = 'NearestNeighbor'
        ext.output_dtype = "int"
    }
}
