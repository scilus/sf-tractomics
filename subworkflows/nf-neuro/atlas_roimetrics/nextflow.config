/*
    ATLAS_ROIMETRICS default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/atlas_roimetrics/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Tractometry options**//
    tractometry_covariates                          = 'site,age,sex,handedness,disease'

    //**IIT**//
    use_atlas_iit                                   = true
}

includeConfig '../../../modules/nf-neuro/registration/ants/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/antsapplytransforms/nextflow.config'
includeConfig '../../../modules/nf-neuro/stats/metricsinroi/nextflow.config'

includeConfig '../atlas_iit/nextflow.config'

process {
    withName: ".*ATLAS_ROIMETRICS:STATS_METRICSINROI" {
        ext.key_substrs_to_remove = {["${task.ext.prefix}_", "_mask_warped", "_warped"]}
        ext.value_substrs_to_remove = {["${task.ext.prefix}__", "${task.ext.prefix}_desc-fwc__"]}
        ext.meta_columns = { params.tractometry_covariates.split(",") }
        ext.normalize_weights = { !params.use_binary_masks }
    }
}
