/*
    HARMONIZATION default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/harmonization/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Harmonization**//
    harmonization_regul_ref                         = 0
    harmonization_regul_mov                         = -1
    harmonization_nu                                = 5
    harmonization_tau                               = 2
    harmonization_limit_age                         = false
    harmonization_ignore_sex                        = false
    harmonization_ignore_handedness                 = false
    harmonization_method                            = "clinical"
}

includeConfig '../../../modules/nf-neuro/harmonization/clinicalcombat/nextflow.config'
includeConfig '../../../modules/nf-neuro/harmonization/stats2combat/nextflow.config'
includeConfig '../../../modules/nf-neuro/harmonization/combat2stats/nextflow.config'

process {
    withName: ".*HARMONIZATION:CLINICALCOMBAT" {
        ext.regul_ref = { params.harmonization_regul_ref }
        ext.regul_mov = { params.harmonization_regul_mov }
        ext.nu = { params.harmonization_nu }
        ext.tau = { params.harmonization_tau }
        ext.limit_age = { params.harmonization_limit_age }
        ext.ignore_sex = { params.harmonization_ignore_sex }
        ext.ignore_handedness = { params.harmonization_ignore_handedness }
        ext.method = { params.harmonization_method }
    }

    withName: ".*HARMONIZATION:STATS2COMBAT_REFERENCE" {
        ext.suffix = "ref"
    }
}
