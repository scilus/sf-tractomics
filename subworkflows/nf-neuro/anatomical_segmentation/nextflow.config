/*
    ANATOMICAL_SEGMENTATION default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/anatomical_segmentation/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

includeConfig '../../../modules/nf-neuro/segmentation/fastseg/nextflow.config'
includeConfig '../../../modules/nf-neuro/segmentation/freesurferseg/nextflow.config'
includeConfig '../../../modules/nf-neuro/segmentation/synthseg/nextflow.config'

params {
    //**T1: Segmentation**//
    run_synthseg                                    = false
}
