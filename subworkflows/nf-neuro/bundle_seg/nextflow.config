/*
    BUNDLE_SEG default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/bundle_seg/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**BundleSeg**//
    atlas_directory                                 = null
}

includeConfig '../../../modules/nf-neuro/bundle/recognize/nextflow.config'

includeConfig '../registration/nextflow.config'

process {
    // BundleSeg does not support easyreg
    withName: ".*BUNDLE_SEG:REGISTRATION:REGISTRATION_.*" {
        ext.allow_easyreg = false
    }
}
