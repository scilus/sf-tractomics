/*
    PREPROC_T1 default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/preproc_t1/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**T1: Denoise**//
    run_t1_denoising                                = true

    //**T1: BET**//
    run_t1_synthstrip                               = false
    run_t1_ants_bet                                 = true

    //**T1: Crop**//
    run_t1_crop                                     = true

    //**T1: Resample**//
    run_t1_resampling                               = true
    t1_resolution                                   = 1
    t1_interpolation                                = "lin"

    //**T1: N4 bias correction options**//
    run_t1_N4                                       = true
}

includeConfig '../../../modules/nf-neuro/denoising/nlmeans/nextflow.config'
includeConfig '../../../modules/nf-neuro/preproc/n4/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/resample/nextflow.config'
includeConfig '../../../modules/nf-neuro/betcrop/antsbet/nextflow.config'
includeConfig '../../../modules/nf-neuro/betcrop/synthstrip/nextflow.config'
includeConfig '../../../modules/nf-neuro/image/cropvolume/nextflow.config'

process {
    withName: ".*PREPROC_T1:IMAGE_CROPVOLUME_T1" {
        ext.output_bbox     = true
        ext.first_suffix    = "t1"
    }

    withName: ".*PREPROC_T1:IMAGE_RESAMPLE" {
        ext.voxel_size      = { params.t1_resolution }
        ext.interp          = { params.t1_interpolation }
        ext.first_suffix    = "t1"
    }
}
