/*
    REGISTRATION default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/registration/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //** Registration **//
    run_synthmorph                                  = false     // Requires FreeSurfer license.
    run_easyreg                                     = false     // Requires FreeSurfer license.
}

includeConfig '../../../modules/nf-neuro/registration/anattodwi/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/ants/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/easyreg/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/synthmorph/nextflow.config'
includeConfig '../../../modules/nf-neuro/registration/convert/nextflow.config'

process {
    // Only one registration method runs. A parent subworkflow can forbid easyreg with ext.allow_easyreg = false
    withName: ".*REGISTRATION:REGISTRATION_EASYREG" {
        ext.when = { params.run_easyreg && task.ext.allow_easyreg != false }
    }

    withName: ".*REGISTRATION:REGISTRATION_SYNTHMORPH" {
        ext.when = { !(params.run_easyreg && task.ext.allow_easyreg != false) && params.run_synthmorph }
    }

    withName: ".*REGISTRATION:(REGISTRATION_ANATTODWI|REGISTRATION_ANTS)" {
        ext.when = { !(params.run_easyreg && task.ext.allow_easyreg != false) && !params.run_synthmorph }
    }
}
