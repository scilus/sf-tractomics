/*
    RECONST_FW_NODDI default configuration (nf-neuro subworkflow).
    Include it in the pipeline config:  includeConfig 'subworkflows/nf-neuro/reconst_fw_noddi/nextflow.config'
    then redefine any of its params after the include to override a default.
    The ext values are closures: they always read the final value of the param.
*/

params {
    //**Diffusion priors**//
    average_diff_priors                             = false  // If true, compute & use mean diffusivity priors across subjects
    para_diff                                       = 1.5e-3  // NODDI | Freewater
    iso_diff                                        = 3e-3    // NODDI | Freewater
    perp_diff_min                                   = 0.1e-3  // Freewater
    perp_diff_max                                   = 0.7e-3  // Freewater

    //**NODDI**//
    run_noddi                                       = false
    noddi_silence_single_shell_warnings             = false
    noddi_lambda1                                   = 0.5
    noddi_lambda2                                   = 1e-3

    //**Freewater Elimination**//
    run_freewater                                   = false
    fw_lambda1                                      = 0
    fw_lambda2                                      = 0.25

    //**Global options**//
    dwi_shell_tolerance                             = 20

    //**Extract DTI shells using this value as maximum**//
    dti_max_shell_value                             = 1200
    dti_shells                                      = null
}

includeConfig '../../../modules/nf-neuro/reconst/diffusivitypriors/nextflow.config'
includeConfig '../../../modules/nf-neuro/reconst/noddi/nextflow.config'
includeConfig '../../../modules/nf-neuro/reconst/freewater/nextflow.config'
includeConfig '../../../modules/nf-neuro/reconst/dtimetrics/nextflow.config'

process {
    withName: ".*RECONST_FW_NODDI:FW_CORRECTED_DTIMETRICS" {
        ext.prefix = { [meta.id, meta.session?: "", meta.run ?: "", "desc-fwc"].findAll { x -> x }.join("_") }
        ext.max_dti_shell_value = { params.dti_max_shell_value }
        ext.dti_shells          = { params.dti_shells }
    }

    withName: ".*RECONST_FW_NODDI:RECONST_FREEWATER" {
        ext.b_thr           = { params.dwi_shell_tolerance }
        ext.para_diff       = { params.para_diff }
        ext.iso_diff        = { params.iso_diff }
        ext.perp_diff_min   = { params.perp_diff_min }
        ext.perp_diff_max   = { params.perp_diff_max }
        ext.fw_lambda1      = { params.fw_lambda1 }
        ext.fw_lambda2      = { params.fw_lambda2 }
    }

    withName: ".*RECONST_FW_NODDI:RECONST_NODDI" {
        ext.para_diff     = { params.para_diff }
        ext.iso_diff      = { params.iso_diff }
        ext.noddi_lambda1 = { params.noddi_lambda1 }
        ext.noddi_lambda2 = { params.noddi_lambda2 }
    }
}
