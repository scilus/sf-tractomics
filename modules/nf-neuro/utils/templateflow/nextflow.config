/*
    UTILS_TEMPLATEFLOW default options (nf-neuro module).
    Every ext option read by the module is listed. Active lines are the defaults; commented lines
    document the options that are off or computed by the module when unset.
    Selected with the module label, so they also apply when the module is imported under an alias.
    Any withName selector (subworkflow or pipeline config) overrides them.
*/
process {
    withLabel: 'utils_templateflow' {
        ext.stub_no_brain_mask = false
    }
}
