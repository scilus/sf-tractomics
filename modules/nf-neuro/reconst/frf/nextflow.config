/*
    RECONST_FRF default options (nf-neuro module).
    Every ext option read by the module is listed. Active lines are the defaults; commented lines
    document the options that are off or computed by the module when unset.
    Selected with the module label, so they also apply when the module is imported under an alias.
    Any withName selector (subworkflow or pipeline config) overrides them.
*/
process {
    withLabel: 'reconst_frf' {
        // ext.prefix               = "${meta.id}"   // standard nf-core option, set by the pipeline
        // ext.fa                   = null   // unset = off
        // ext.fa_min               = null   // unset = off
        // ext.nvox_min             = null   // unset = off
        // ext.roi_radius           = null   // unset = off
        // ext.dwi_shell_tolerance  = null   // unset = off
        ext.max_dti_shell_value  = 1500
        ext.min_fodf_shell_value = 100
        ext.b0_thr_extract_b0    = 10
        // ext.dti_shells           = null   // default: "\$(cut -d ' ' --output-delimiter=\$'\\n' -f 1- $bval | awk -F' ' '{v=int(\$1)}{if(v<=$max_dti_shell_value|| v<=$b0_thr_extract_b0)print v}' | sort | uniq)"
        // ext.fodf_shells          = null   // unset = off
        // ext.method               = null   // unset = off
        // ext.precision            = null   // unset = off
        // ext.fa_thr_wm            = null   // unset = off
        // ext.fa_thr_gm            = null   // unset = off
        // ext.fa_thr_csf           = null   // unset = off
        // ext.md_thr_wm            = null   // unset = off
        // ext.md_thr_gm            = null   // unset = off
        // ext.md_thr_csf           = null   // unset = off
        // ext.manual_frf           = null   // unset = off
        // ext.manual_wm_frf        = null   // unset = off
        // ext.manual_gm_frf        = null   // unset = off
        // ext.manual_csf_frf       = null   // unset = off
        // ext.single_thread        = null   // unset = off
        // ext.set_frf              = null   // unset = off
    }
}
