/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    scilus/sf-tractomics Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {
    // Input options
    input                      = null
    fs                         = null
    bidsignore                 = null
    bids_config                = null

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load the defaults of the nf-neuro modules called directly by the pipeline
includeConfig 'modules/nf-neuro/qc/multiqc/nextflow.config'
includeConfig 'modules/nf-neuro/tractogram/math/nextflow.config'
includeConfig 'modules/nf-neuro/qc/tractogram/nextflow.config'
includeConfig 'modules/nf-neuro/stats/metricsinroi/nextflow.config'
includeConfig 'modules/nf-neuro/registration/antsapplytransforms/nextflow.config'
includeConfig 'modules/nf-neuro/registration/tractogram/nextflow.config'

// Load the defaults of the nf-neuro subworkflows (params + ext of their modules)
includeConfig 'subworkflows/nf-neuro/tractoflow/nextflow.config'
includeConfig 'subworkflows/nf-neuro/bundle_seg/nextflow.config'
includeConfig 'subworkflows/nf-neuro/reconst_fw_noddi/nextflow.config'
includeConfig 'subworkflows/nf-neuro/atlas_roimetrics/nextflow.config'
includeConfig 'subworkflows/nf-neuro/tractometry/nextflow.config'
includeConfig 'subworkflows/nf-neuro/harmonization/nextflow.config'
includeConfig 'subworkflows/nf-neuro/output_template_space/nextflow.config'

/*
    sf-tractomics params. Defined after the includes: any param redefined here
    overrides the default set by a subworkflow config (e.g. pft_nbr_seeds).
*/
params {

    //*Input + Output options (non-file)**//
    clean_bids                                      = false
    clean_output                                    = true
    participants_tsv                                = null
    participant_label                               = ""
    exclude_participant_label                       = ""
    match_t1_run                                    = true

    //*DWI: Processing options**//
    synthstrip_weights                              = null

    //**T1: Denoise**//
    template_t1                                     = null

    //**SH fitting**//
    sh_fitting                                      = false
    sh_fitting_order                                = 6
    sh_fitting_basis                                = "descoteaux07"
    sh_fitting_shells                               = null

    //**Local tracking (LT)**//
    local_sfthres_init                              = 0.5

    //**BundleSeg**//
    run_bundle_seg                                  = false

    //*Tractometry options**//
    run_tractometry                                 = false

    //**Atlas-based ROI metrics**//
    run_atlas_roimetrics                            = false

    //**Harmonization**//
    harmonization_reference                         = null

    //**Output in original space**//
    output_orig_space                               = false

    //**Output template space**//
    output_template_space                           = false
}

// Pipeline specific module options: publishing paths, resources.
// Included after the params above: it reads them when it is loaded.
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 4.h
            ]
        }
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        // ** GPU config ** //
        includeConfig 'conf/gpu.config'
    }
    slurm {
        process {
            errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 126) ? 'retry' : 'finish' }
            maxRetries          = 1
            cache               = "lenient"
            afterScript         = "sleep 60"
            scratch             = true
        }

        executor {
            name                = 'slurm'
            queueSize           = 950
            queueGlobalStatus   = false
            queueStatInterval   = '3 min'
            submitRateLimit     = '10/1sec'
            exitReadTimeout     = '30 min'
            pollInterval        = '30 sec'
            jobName             = {
                task.name
                    .replace("[", "(")
                    .replace("]", ")")
                    .replace(" ", "_")
            }
        }

        singularity.runOptions    = "--no-home --containall --writable-tmpfs"
        apptainer.runOptions      = "--no-home --containall --writable-tmpfs"

        includeConfig 'conf/slurm.config'
    }
    legacy {
        includeConfig 'conf/legacy.config'
    }
    reproducible {
        includeConfig 'conf/reproducible.config'
    }
    full_pipeline {
        includeConfig 'conf/full_pipeline.config'
    }
    iit_tractometry {
        includeConfig 'conf/iit_tractometry.config'
    }
    skip_preproc {
        includeConfig 'conf/skip_preproc.config'
    }
    no_crop_no_mask {
        includeConfig 'conf/no_crop_no_mask.config'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load scilus/sf-tractomics custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'docker.io'
docker.registry       = 'docker.io'
podman.registry       = 'docker.io'
singularity.registry  = 'docker.io'
charliecloud.registry = 'docker.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    OPENBLAS_NUM_THREADS = 1
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    overwrite = true
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'scilus/sf-tractomics'
    author          = """@AlexVCaron"""
    contributors    = [
        [
            name: '@AlexVCaron',
            affiliation: 'Sherbrooke Connectivity Imaging Lab (SCIL) - Université de Sherbrooke',
            email: 'alex.valcourt.caron@usherbrooke.ca',
            github: 'https://github.com/AlexVCaron',
            contribution: ['author', 'maintainer', 'contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: '0000-0002-1206-6395'
        ],
        [
            name: '@arnaudbore',
            affiliation: 'Sherbrooke Connectivity Imaging Lab (SCIL) - Université de Sherbrooke',
            email: 'arnaud.bore@usherbrooke.ca',
            github: 'https://github.com/arnaudbore',
            contribution: ['author', 'maintainer', 'contributor'],
            orcid: '0000-0002-4822-1211'
        ],
        [
            name: '@gagnonanthony',
            affiliation: 'Sherbrooke Connectivity Imaging Lab (SCIL) - Université de Sherbrooke',
            email: 'anthony.gagnon7@usherbrooke.ca',
            github: 'https://github.com/gagnonanthony',
            contribution: ['author', 'maintainer', 'contributor'],
            orcid: '0000-0002-4468-0269'
        ],
        [
            name: '@GuillaumeTh',
            affiliation: 'Université de Montréal affiliated research center (CRCHUM)',
            email: '',
            github: 'https://github.com/guillaumeth',
            contribution: ['author'],
            orcid: '0000-0002-8440-1009'
        ],
    ]
    homePage        = 'https://github.com/scilus/sf-tractomics'
    description     = """Human diffusion MRI processing and tractography"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.2'
    version         = '0.2.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1'
    id 'nf-bids@0.3.0'
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}
