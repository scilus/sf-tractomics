            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("mask_wm.nii.gz")) { "${prefix}_label-WM_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("mask_gm.nii.gz")) { "${prefix}_label-GM_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("mask_csf.nii.gz")) { "${prefix}_label-CSF_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("map_wm.nii.gz")) { "${prefix}_label-WM_desc-fastseg_probseg.nii.gz" }
                else if (filename.endsWith("map_gm.nii.gz")) { "${prefix}_label-GM_desc-fastseg_probseg.nii.gz" }
                else if (filename.endsWith("map_csf.nii.gz")) { "${prefix}_label-CSF_desc-fastseg_probseg.nii.gz" }
                else { null }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:ANATOMICAL_SEGMENTATION:SEGMENTATION_FREESURFERSEG" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("mask_wm.nii.gz")) { "${prefix}_label-WM_desc-freesurfer_mask.nii.gz" }
                else if (filename.endsWith("mask_gm.nii.gz")) { "${prefix}_label-GM_desc-freesurfer_mask.nii.gz" }
                else if (filename.endsWith("mask_csf.nii.gz")) { "${prefix}_label-CSF_desc-freesurfer_mask.nii.gz" }
                else { null }
            }
        ]
    }

    withName: ".*:STATS_METRICSINROI" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains(".csv") ) { "${prefix}_atlas-iit_desc-roi_stats.csv" }
                else if ( filename.contains(".tsv") ) { "${prefix}_atlas-iit_desc-roi_stats.tsv" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:TRACKING_LOCALTRACKING" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("local_tracking.trk") ) { "${prefix}_desc-local_tractogram.trk" }
                else if ( filename.contains("seeding_mask") ) { "${prefix}_space-DWI_label-seeding_desc-local_mask.nii.gz" }
                else if ( filename.contains("tracking_mask") ) { "${prefix}_space-DWI_label-tracking_desc-local_mask.nii.gz"}
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:TRACKING_PFTTRACKING" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("pft_tracking.trk") ) { "${prefix}_desc-pft_tractogram.trk" }
                else if ( filename.contains("seeding_mask") ) { "${prefix}_space-DWI_label-seeding_desc-pft_mask.nii.gz" }
                else if ( filename.contains("map_include") ) { "${prefix}_space-DWI_label-include_desc-pft_probseg.nii.gz"}
                else if ( filename.contains("map_exclude") ) { "${prefix}_space-DWI_label-exclude_desc-pft_probseg.nii.gz"}
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:ENSEMBLE_TRACKING" {
        memory = { 3 * trks.inject( 0.Gb ){ total, trk -> total + (trk.size() as MemoryUnit) } + 500.Mb }
        ext.operation       = "union"
        ext.suffix          = "ensemble"
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ensemble.trk") ) { "${prefix}_desc-ensemble_tractogram.trk" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:EXTRACT_B0" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("_b0.nii.gz") ) { "${prefix}_desc-preproc_b0.nii.gz" }
                else if ( filename.contains("bvec") ) { "${prefix}_desc-preproc_dwi.bvec" }
                else if ( filename.contains("bval") ) {"${prefix}_desc-preproc_dwi.bval"}
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:OUTPUT_TEMPLATE_SPACE:UTILS_TEMPLATEFLOW" {
        publishDir = [
            path: "${params.templateflow_home}/",
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if ( filename.endsWith("${params.template}") ) { "tpl-${params.template}" }
                else if ( filename.contains("${params.template}_metadata") ) { "tpl-${params.template}_metadata.json" }
                else if ( filename.contains("${params.template}_citations") ) { "tpl-${params.template}_citations.bib" }
                else if ( filename.equals("versions.yml") ) { null }
            }
        ]
    }
}
