/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline specific settings: publishing paths, resources and the options of the
    modules called directly by the pipeline. The defaults of the nf-neuro subworkflows
    live in subworkflows/nf-neuro/<name>/nextflow.config.
----------------------------------------------------------------------------------------
*/

process {
    withName: ".*:TRACTOFLOW:PREPROC_T1:BETCROP_ANTSBET" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("t1_bet.nii.gz")) { "${prefix}_T1w.nii.gz" }
                else if (filename.endsWith("t1_bet_mask.nii.gz")) { "${prefix}_desc-brain_mask.nii.gz" }
                else { null }
            },
            enabled: params.clean_output
        ]
    }

    withName: ".*:OUTPUT_TEMPLATE_SPACE:BET_T1W" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:BUNDLE_SEG:BUNDLE_RECOGNIZE" {
        memory = {
            def trk_list = (tractograms instanceof List) ? tractograms : [tractograms]
            def total = trk_list.inject(0.Gb) { total, trk ->
                total + ((trk?.exists()) ? (trk.size() as MemoryUnit) : 0.B)
            }
            3 * total + 500.Mb
        }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/bundles/" : "${params.outdir}/${meta.id}/dwi/bundles/" },
            mode: params.publish_dir_mode,
            pattern: "*_cleaned.trk",
            saveAs: { filename ->
                def new_filename = filename.replace("__", "_")
                return new_filename.replace("_cleaned", "")
            }
        ]
    }

    withName: ".*:BUNDLE_STATS" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi" : "${params.outdir}/${meta.id}/dwi" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("_desc-point_param-lesions_stats.tsv")) { "${prefix}_label-point_param-lesions_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-mean_param-lesions_stats.tsv")) { "${prefix}_label-mean_param-lesions_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-mean_stats.tsv")) { "${prefix}_label-mean_desc-tractometry_stats.tsv" }
                else if (filename.endsWith("_desc-point_stats.tsv")) { "${prefix}_label-point_desc-tractometry_stats.tsv" }
                else { null }
            }
        ]
    }

    withName: ".*:HARMONIZATION:CLINICALCOMBAT" {
        publishDir = [
            [
                path: "${params.outdir}/harmonization_models/",
                mode: params.publish_dir_mode,
                pattern: "*.model.csv"
            ]
        ]
    }

    withName: ".*:HARMONIZATION:COMBAT2STATS" {
        publishDir = [
            [
                path: "${params.outdir}/metrics/",
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,tsv.gz,json}",
                saveAs: { filename ->
                    def extension = "tsv"
                    if (filename.endsWith(".tsv.gz")) {
                        extension = "tsv.gz"
                    }
                    else if (filename.endsWith(".json")) {
                        extension = "json"
                    }
                    return "space-harmonized_atlas-iit_label-mean_desc-roi_stats.${extension}"
                }
            ]
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_T1:IMAGE_CROPVOLUME_T1" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith("_t1_cropped.nii.gz") ? "${prefix}_space-T1w_desc-preproc_T1w.nii.gz" : null
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_T1:IMAGE_CROPVOLUME_MASK" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                filename.endsWith("_cropped.nii.gz") ? "${prefix}_space-T1w_desc-brain_mask.nii.gz" : null
            }
        ]
    }

    withName: ".*ATLAS_IIT:THR_BUNDLE_MASK" {
        memory        = 1.GB
        time          = 20.M
    }

    withName: ".*ATLAS_IIT:SMOOTH_MASK" {
        memory        = 1.GB
        time          = 20.M
    }

    withName: ".*ATLAS_IIT:THR_SMOOTHED_MASK" {
        memory        = 1.GB
        time          = 20.M
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:RESAMPLE_DWI" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("_resampled.nii.gz") ) { "${prefix}_desc-preproc_dwi.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:RESAMPLE_MASK" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("_resampled.nii.gz") ) { "${prefix}_desc-brain_mask.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:PREPROC_DWI:TOPUP_EDDY:PREPROC_EDDY" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: "MULTIQC" {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\" --verbose" : "--verbose" }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/multiqc/" : "${params.outdir}/${meta.id}/multiqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: "MULTIQC_GLOBAL" {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\" --verbose" : "--verbose" }
        publishDir = [
            path: { "${params.outdir}/multiqc/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ".*:QC_ENSEMBLE" {
        memory = { 2 * (tractogram.size() as MemoryUnit) + 500.Mb }
    }

    withName: ".*:TRACTOFLOW:RECONST_DTIMETRICS" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ad.nii.gz") ) { "${prefix}_model-tensor_param-ad_dwimap.nii.gz" }
                else if ( filename.contains("fa.nii.gz") ) { "${prefix}_model-tensor_param-fa_dwimap.nii.gz" }
                else if ( filename.contains("rd.nii.gz") ) { "${prefix}_model-tensor_param-rd_dwimap.nii.gz" }
                else if ( filename.contains("md.nii.gz") ) { "${prefix}_model-tensor_param-md_dwimap.nii.gz" }
                else if ( filename.contains("mode.nii.gz") ) { "${prefix}_model-tensor_param-mode_dwimap.nii.gz" }
                else if ( filename.contains("tensor.nii.gz") ) { "${prefix}_model-tensor_param-tensor_dwimap.nii.gz" }
                else if ( filename.contains("rgb.nii.gz") ) { "${prefix}_model-tensor_param-rgb_dwimap.nii.gz" }
                else if ( filename.contains("ga.nii.gz") ) { "${prefix}_model-tensor_param-ga_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:FW_CORRECTED_DTIMETRICS" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("ad.nii.gz") ) { "${prefix}_model-tensor_param-ad_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("fa.nii.gz") ) { "${prefix}_model-tensor_param-fa_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rd.nii.gz") ) { "${prefix}_model-tensor_param-rd_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("md.nii.gz") ) { "${prefix}_model-tensor_param-md_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("mode.nii.gz") ) { "${prefix}_model-tensor_param-mode_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("tensor.nii.gz") ) { "${prefix}_model-tensor_param-tensor_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("rgb.nii.gz") ) { "${prefix}_model-tensor_param-rgb_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("ga.nii.gz") ) { "${prefix}_model-tensor_param-ga_desc-fwc_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:RECONST_FODF" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("__fodf.nii.gz") ) { "${prefix}_model-csd_param-sh_dwimap.nii.gz" }
                else if ( filename.contains("wm_fodf.nii.gz") ) { "${prefix}_model-csd_param-wmsh_dwimap.nii.gz" }
                else if ( filename.contains("gm_fodf.nii.gz") ) { "${prefix}_model-csd_param-gmsh_dwimap.nii.gz" }
                else if ( filename.contains("csf_fodf.nii.gz") ) { "${prefix}_model-csd_param-csfsh_dwimap.nii.gz" }
                else if ( filename.contains("peaks.nii.gz") ) { "${prefix}_model-csd_param-peaks_dwimap.nii.gz" }
                else if ( filename.contains("afd_total.nii.gz") ) { "${prefix}_model-csd_param-afdtotal_dwimap.nii.gz" }
                else if ( filename.contains("nufo.nii.gz") ) { "${prefix}_model-csd_param-nufo_dwimap.nii.gz" }
                else if ( filename.contains("afd_max.nii.gz") ) { "${prefix}_model-csd_param-afdmax_dwimap.nii.gz" }
                else if ( filename.contains("afd_sum.nii.gz") ) { "${prefix}_model-csd_param-afdsum_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_FREEWATER" {
        memory = { 8.GB * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("fwf.nii.gz") ) { "${prefix}_model-fw_param-fwf_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:RECONST_FRF" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("__frf.txt") ) { "${prefix}_frf.txt" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_NODDI" {
        memory = { 8.GB * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("icvf.nii.gz") ) { "${prefix}_model-noddi_param-icvf_dwimap.nii.gz" }
                else if ( filename.contains("odi.nii.gz") ) { "${prefix}_model-noddi_param-odi_dwimap.nii.gz" }
                else if ( filename.contains("isovf.nii.gz") ) { "${prefix}_model-noddi_param-isovf_dwimap.nii.gz" }
                else if ( filename.contains("dir.nii.gz") ) { "${prefix}_model-noddi_param-dir_dwimap.nii.gz" }
                else if ( filename.contains("ecvf.nii.gz") ) { "${prefix}_model-noddi_param-ecvf_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_QBALL" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
            saveAs: {
                filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if ( filename.contains("gfa.nii.gz") ) { "${prefix}_model-qball_param-gfa_dwimap.nii.gz" }
                else if ( filename.contains("peaks.nii.gz") ) { "${prefix}_model-qball_param-peaks_dwimap.nii.gz" }
                else if ( filename.contains("nufo.nii.gz") ) { "${prefix}_model-qball_param-nufo_dwimap.nii.gz" }
                else if ( filename.contains("qball.nii.gz") ) { "${prefix}_model-qball_param-sh_dwimap.nii.gz" }
                else if ( filename.contains("versions.yml") ) { null }
                else { params.clean_output ? null : filename }
            }
        ]
    }

    withName: ".*:RECONST_SHSIGNAL" {
        ext.dwi_shell_tolerance = { params.dwi_shell_tolerance }
        ext.b0_thr_extract_b0   = { params.b0_thr_extract_b0 }
        ext.shell_to_fit        = { params.sh_fitting_shells }
        ext.sh_order            = { params.sh_fitting_order }
        ext.sh_basis            = { params.sh_fitting_basis }
    }

    withName: ".*:TRACTOFLOW:T1_REGISTRATION:REGISTRATION_ANATTODWI" {
        publishDir = [
            [
                // Based on: https://bids.neuroimaging.io/extensions/beps/bep_014.html
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/xfm" : "${params.outdir}/${meta.id}/xfm" },
                mode: params.publish_dir_mode,
                enabled: params.clean_output,
                pattern: "*{warp.nii.gz,affine.mat}",
                saveAs: { filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if (filename.endsWith("_forward1_affine.mat")) { "${prefix}_from-T1w_to-dwi_mode-image_desc-affine_xfm.mat" }
                    else if (filename.endsWith("_forward0_warp.nii.gz")) { "${prefix}_from-T1w_to-dwi_mode-image_desc-warp_xfm.nii.gz" }
                    else if (filename.endsWith("_backward1_warp.nii.gz")) { "${prefix}_from-dwi_to-T1w_mode-image_desc-warp_xfm.nii.gz" }
                    else if (filename.endsWith("_backward0_affine.mat")) { "${prefix}_from-dwi_to-T1w_mode-image_desc-affine_xfm.mat" }
                    else { null }
                }
            ],
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
                mode: params.publish_dir_mode,
                enabled: params.clean_output,
                pattern: "*warped.nii.gz",
                saveAs: { filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if (filename.endsWith("warped.nii.gz")) { "${prefix}_space-dwi_desc-preproc_T1w.nii.gz" }
                    else { null }
                }
            ]
        ]
    }

    withName: ".*:OUTPUT_TEMPLATE_SPACE:REGISTRATION:REGISTRATION_ANTS" {
        publishDir = [
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("warped.nii.gz") ) { "${prefix}_space-${params.template}_desc-preproc_T1w.nii.gz" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
            ],
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/xfm/" : "${params.outdir}/${meta.id}/xfm/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("_forward0_warp.nii.gz") ) { "${prefix}_from-dwi_to-${params.template}_mode-image_desc-warp_xfm.nii.gz" }
                    else if ( filename.contains("_forward1_affine.mat") ) { "${prefix}_from-dwi_to-${params.template}_mode-image_desc-affine_xfm.mat" }
                    else if ( filename.contains("_backward1_warp.nii.gz") ) { "${prefix}_from-${params.template}_to-dwi_mode-image_desc-warp_xfm.nii.gz" }
                    else if ( filename.contains("_backward0_affine.mat") ) { "${prefix}_from-${params.template}_to-dwi_mode-image_desc-affine_xfm.mat" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
            ]
        ]
    }

    withName: ".*:REGISTRATION_METRICS_TO_ORIG" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
            mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("ad") ) { "${prefix}_space-orig_model-tensor_param-ad_dwimap.nii.gz" }
                    else if ( filename.contains("_fa_") ) { "${prefix}_space-orig_model-tensor_param-fa_dwimap.nii.gz" }
                    else if ( filename.contains("_rd_") ) { "${prefix}_space-orig_model-tensor_param-rd_dwimap.nii.gz" }
                    else if ( filename.contains("_md_") ) { "${prefix}_space-orig_model-tensor_param-md_dwimap.nii.gz" }
                    else if ( filename.contains("_mode_") ) { "${prefix}_space-orig_model-tensor_param-mode_dwimap.nii.gz" }
                    else if ( filename.contains("_ga_") ) { "${prefix}_space-orig_model-tensor_param-ga_dwimap.nii.gz" }
                    else if ( filename.contains("_afd_total_") ) { "${prefix}_space-orig_model-csd_param-afdtotal_dwimap.nii.gz" }
                    else if ( filename.contains("_nufo_") ) { "${prefix}_space-orig_model-csd_param-nufo_dwimap.nii.gz" }
                    else if ( filename.contains("_afd_max_") ) { "${prefix}_space-orig_model-csd_param-afdmax_dwimap.nii.gz" }
                    else if ( filename.contains("_afd_sum_") ) { "${prefix}_space-orig_model-csd_param-afdsum_dwimap.nii.gz" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
        ]
    }

    withName: ".*:OUTPUT_TEMPLATE_SPACE:WARPIMAGES" {
        publishDir = [
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat/" : "${params.outdir}/${meta.id}/anat/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("WM_probseg") ) { "${prefix}_space-${params.template}_label-WM_probseg.nii.gz" }
                    else if ( filename.contains("GM_probseg") ) { "${prefix}_space-${params.template}_label-GM_probseg.nii.gz" }
                    else if ( filename.contains("CSF_probseg") ) { "${prefix}_space-${params.template}_label-CSF_probseg.nii.gz" }
                    else if ( filename.contains("map_wm") ) { "${prefix}_space-${params.template}_label-WM_probseg.nii.gz" }
                    else if ( filename.contains("map_gm") ) { "${prefix}_space-${params.template}_label-GM_probseg.nii.gz" }
                    else if ( filename.contains("map_csf") ) { "${prefix}_space-${params.template}_label-CSF_probseg.nii.gz" }
                    else if ( filename.contains("versions.yml") ) { null }
                }
            ],
            [
                path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/dwi/" : "${params.outdir}/${meta.id}/dwi/" },
                mode: params.publish_dir_mode,
                saveAs: {
                    filename ->
                    def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                    if ( filename.contains("ad") && filename.contains("desc-fwc")){
                        "${prefix}_space-${params.template}_model-tensor_param-ad_desc-fwc_dwimap.nii.gz"
                    }
                    else if ( filename.contains("fa") && filename.contains("desc-fwc")){
                        "${prefix}_space-${params.template}_model-tensor_param-fa_desc-fwc_dwimap.nii.gz"
                    }
                    else if ( filename.contains("rd") && filename.contains("desc-fwc")){
                        "${prefix}_space-${params.template}_model-tensor_param-rd_desc-fwc_dwimap.nii.gz"
                    }
                    else if ( filename.contains("md") && filename.contains("desc-fwc")){
                        "${prefix}_space-${params.template}_model-tensor_param-md_desc-fwc_dwimap.nii.gz"
                    }
                    else if ( filename.contains("isovf") ) {
