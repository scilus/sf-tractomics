/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: ".*:SEGMENTATION_FASTSURFER" {
        ext.acq3T           = false
        ext.cerebnet        = false
        ext.hypvinn         = false
        ext.seg_only        = false     // Surface reconstruction is required to produce wmparc.
        cpus                = { 4                   }
        memory              = { 16.GB * task.attempt }
        time                = { 8.h   * task.attempt }
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename -> filename.endsWith("_fastsurfer") ? filename : null }
        ]
    }

    withName: ".*:CONVERT_FASTSURFER_WMPARC" {
        ext.datatype        = "int16"
        ext.first_suffix    = "wmparc"
    }

    withName: ".*:CONVERT_FASTSURFER_APARC_ASEG" {
        ext.datatype        = "int16"
        ext.first_suffix    = "aparc_aseg"
    }

    withName: ".*:TRACTOFLOW:TRANSFORM_WMPARC" {
        ext.dimensionality  = 3
        ext.image_type      = 0
        ext.interpolation   = "NearestNeighbor"
        ext.output_dtype    = "uchar"
        ext.default_val     = 0
    }

    withName: ".*:TRACTOFLOW:TRANSFORM_APARC_ASEG" {
        ext.dimensionality  = 3
        ext.image_type      = 0
        ext.interpolation   = "MultiLabel"
        ext.output_dtype    = "short"
        ext.default_val     = 0
    }

    withName: ".*:TRACTOFLOW:TRANSFORM_LESION_MASK" {
        ext.dimensionality  = 3
        ext.image_type      = 0
        ext.interpolation   = "NearestNeighbor"
        ext.output_dtype    = "uchar"
        ext.default_val     = 0
    }

    withName: ".*:TRACTOFLOW:TRANSFORM_BRAINMASK" {
        ext.dimensionality  = 3
        ext.image_type      = 0
        ext.interpolation   = "NearestNeighbor"
        ext.output_dtype    = "uchar"
        ext.default_val     = 0
    }

    withName: ".*:TRACTOFLOW:ANATOMICAL_SEGMENTATION:SEGMENTATION_FASTSEG" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("mask_wm.nii.gz")) { "${prefix}_label-WM_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("mask_gm.nii.gz")) { "${prefix}_label-GM_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("mask_csf.nii.gz")) { "${prefix}_label-CSF_desc-fastseg_mask.nii.gz" }
                else if (filename.endsWith("map_wm.nii.gz")) { "${prefix}_label-WM_desc-fastseg_probseg.nii.gz" }
                else if (filename.endsWith("map_gm.nii.gz")) { "${prefix}_label-GM_desc-fastseg_probseg.nii.gz" }
                else if (filename.endsWith("map_csf.nii.gz")) { "${prefix}_label-CSF_desc-fastseg_probseg.nii.gz" }
                else { null }
            }
        ]
    }

    withName: ".*:TRACTOFLOW:ANATOMICAL_SEGMENTATION:SEGMENTATION_FREESURFERSEG" {
        publishDir = [
            path: { meta.session ? "${params.outdir}/${meta.id}/${meta.session}/anat" : "${params.outdir}/${meta.id}/anat" },
            mode: params.publish_dir_mode,
            enabled: params.clean_output,
            saveAs: { filename ->
                def prefix = [meta.id, meta.session, meta.run].findAll().join("_")
                if (filename.endsWith("mask_wm.nii.gz")) { "${prefix}_label-WM_desc-freesurfer_mask.nii.gz" }
                else if (filename.endsWith("mask_gm.nii.gz")) { "${prefix}_label-GM_desc-freesurfer_mask.nii.gz" }
                else if (filename.endsWith("mask_csf.nii.gz")) { "${prefix}_label-CSF_desc-freesurfer_mask.nii.gz" }
                else { null }
            }
        ]
    }
}
